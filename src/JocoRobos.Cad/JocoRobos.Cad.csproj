<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>JocoRobos.Cad</AssemblyName>
    <RootNamespace>JocoRobos.Cad</RootNamespace>
    <Version>1.15.0</Version>
    <!-- Keep COM registration identity stable across these milestone updates. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <!-- Without these, .NET copies AssemblyVersion (0.1.0.0) into the file version and the updater can't tell releases apart. -->
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SharpSvnPlatform>x64</SharpSvnPlatform>
    <RegisterForComInterop>false</RegisterForComInterop>
    <SolidWorksInteropDir Condition="'$(SolidWorksInteropDir)' == ''">$(ProgramW6432)\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksInteropDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Toolbar, task pane, and button icons, loaded from the Icons folder next to the DLL. Rebuild them with tools/make-icons.py. -->
    <None Include="Icons\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="Icons" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpSvn" Version="1.14005.390" />
    <!-- Polygon offsets and booleans for Lighten Plate (Boost license). -->
    <PackageReference Include="Clipper2" Version="1.5.4" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckSolidWorksReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll') Or !Exists('$(SolidWorksInteropDir)\SolidWorks.Interop.swconst.dll') Or !Exists('$(SolidWorksInteropDir)\SolidWorks.Interop.swpublished.dll')"
           Text="SOLIDWORKS API assemblies not found. Set SolidWorksInteropDir to the installed SOLIDWORKS api\redist directory." />
  </Target>
</Project>
