# Your team's server settings. Copy to team.env (never commit team.env: it can hold your Onshape keys).

# The public name students type into SOLIDWORKS, without https://
JOCO_SERVER_NAME=cad.yourteam.org
# Shown on the server's public front page.
JOCO_TEAM_NAME=FIRST Robotics Competition Team 0000
# The robot season created (empty, with standard folders) on first start; more from the mentor page later.
# Set it to none if you'll import your existing robot CAD instead (docs/SETUP.md step 3).
JOCO_FIRST_SEASON=2026-Robot

# Optional: FRCDesignLib parts in the add-in's Library tab need an Onshape API key (https://dev-portal.onshape.com/keys,
# read-only is enough). Leave empty to turn FRCDesignLib off; everything else works without it.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
