[Unit]
Description=JOCO ROBOS CAD SVN
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/podman run --rm --name joco-svn --publish 127.0.0.1:8091:80 --volume %h/server/joco-cad/data:/var/lib/svn --volume %h/server/joco-cad/config:/etc/joco --env-file %h/server/joco-cad/secrets/onshape.env localhost/joco-svn:v22
ExecStop=/usr/bin/podman stop --time 20 joco-svn
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=default.target
